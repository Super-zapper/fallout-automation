      "blocks": {
        "skillCheck": {
          "name": "Skill check with GM confirmation",
          "hint": "The runFalloutCheck function: a skill roll whose result the GM confirms."
        },
        "rollEngine": {
          "name": "Roll Engine (targets and hit location)",
          "hint": "Remembers the targets and hit location of an attack and passes them on to the damage roll."
        },
        "difficulty": {
          "name": "Difficulty Engine (difficulty and verdict)",
          "hint": "Calculates roll difficulty, shows success or failure, adds Action Points."
        },
